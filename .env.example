# ---------------------------------------------------------------------------
# PlanWise AI — environment variables (copy to backend/.env and frontend/.env)
# ---------------------------------------------------------------------------

# === Backend (backend/.env) ===

# Google Gemini. If omitted, the backend uses a deterministic local plan
# generator that is clearly labelled as a fallback (app still fully works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Persistence backend: "json" (default, zero-config) or "firestore"
PERSISTENCE=json

# Firestore (only needed when PERSISTENCE=firestore). Do NOT commit the file.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Optional: enable Firebase Auth token verification on private routes
REQUIRE_AUTH=false

# Request/AI timeouts (seconds)
AI_TIMEOUT_SECONDS=30

# === Frontend (frontend/.env) ===
VITE_API_BASE_URL=http://localhost:8000
