# Backend API base URL (localhost for dev, deployed URL in production)
VITE_API_BASE_URL=http://localhost:8000

# --- Firebase Authentication (OPTIONAL) ---
# Leave these blank to run anonymously (backend must have REQUIRE_AUTH=false).
# Fill them in to enable Google sign-in. The web apiKey is a public project
# identifier (safe in the browser), NOT a secret. Values come from Firebase
# Console -> Project settings -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
